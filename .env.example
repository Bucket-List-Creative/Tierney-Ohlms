# --- Site ---
# Canonical origin, used for canonical tags, the sitemap, and structured data.
# MUST be set in the production environment before the first deploy — without it
# canonicals fall back to a default and may point at the wrong host.
NEXT_PUBLIC_SITE_URL="https://www.tierneyohlms.com"

# --- Sanity ---
# Find these in https://manage.sanity.io  →  your project  →  API
NEXT_PUBLIC_SANITY_PROJECT_ID="your_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2025-01-01"

# Server-only read token (Viewer role is enough) — used for draft/preview + server fetches.
# NEVER prefix this with NEXT_PUBLIC_ and never expose it to the client.
SANITY_API_READ_TOKEN="your_read_token"

# Server-only WRITE token (Editor role) — only needed to run `npm run sanity:push`,
# which pushes scripts/seed.ndjson into the dataset. Not read by the app at runtime.
SANITY_API_WRITE_TOKEN="your_editor_token"

# Shared secret for the Sanity webhook that revalidates the site on publish.
# Set the same value in the Sanity webhook config (see README).
SANITY_REVALIDATE_SECRET="a_long_random_string"
